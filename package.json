{
  "name": "bleek",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/sync-astro-schema.mjs && prisma generate --schema prisma/schema",
    "db:generate": "prisma generate --schema prisma/schema",
    "db:migrate": "prisma migrate dev --schema prisma/schema",
    "db:deploy": "prisma migrate deploy --schema prisma/schema",
    "db:studio": "prisma studio --schema prisma/schema",
    "staff:grant": "node scripts/grant-staff.mjs",
    "seed:accounts": "npx --yes tsx@4.23.15 scripts/seed-astro-accounts.ts"
  },
  "dependencies": {
    "@astro/core": "github:smking89/Astro",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true
  }
}
