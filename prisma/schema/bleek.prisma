// ASTRO — unified schema for the Bleek · Koba.games · SnagChat ecosystem.
// One User owns one AccountWallet (the shared coin balance across every product)
// and any number of UserConnection rows (the profile link chips).
//
//   npx prisma generate
//   npx prisma migrate dev --name astro_init
//
// DATABASE_URL is the only environment variable this schema reads.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppEnvironment {
  DEVELOPMENT
  PRODUCTION
}

enum DeveloperAppStatus {
  ACTIVE
  REVOKED
}

enum CaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// The single identity shared by every ASTRO product.

model DeveloperApp {
  id           String             @id @default(cuid())
  ownerId      String
  name         String
  description  String?
  /// Public identifier, safe to show in logs and dashboards.
  clientId     String             @unique
  /// Display prefix of the secret, e.g. "astro_sk_4f2a".
  keyPrefix    String
  /// SHA-256 of the full secret. The secret itself is shown once and never stored.
  keyHash      String             @unique
  lastFour     String
  scopes       String[]           @default([])
  environment  AppEnvironment     @default(DEVELOPMENT)
  status       DeveloperAppStatus @default(ACTIVE)
  redirectUri  String?
  requestCount Int                @default(0)
  errorCount   Int                @default(0)
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  owner    User            @relation("AppOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  usage    ApiUsageDaily[]
  requests ApiRequest[]

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("developer_apps")
}

/// One row per app per UTC day; the source for the portal's usage charts.

model ApiUsageDaily {
  id       String   @id @default(cuid())
  appId    String
  day      DateTime @db.Date
  requests Int      @default(0)
  errors   Int      @default(0)

  app DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([appId, day])
  @@index([day])
  @@map("api_usage_daily")
}

/// Recent API calls, capped by a rolling 30-day prune, for the request inspector.

model ApiRequest {
  id         String   @id @default(cuid())
  appId      String
  method     String
  path       String
  status     Int
  durationMs Int
  ip         String?
  createdAt  DateTime @default(now())

  app DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([appId, createdAt])
  @@index([createdAt])
  @@map("api_requests")
}

/// A moderation report moving through the staff queue.

model ModerationCase {
  id             String       @id @default(cuid())
  reference      String       @unique
  subjectId      String?
  subjectHandle  String
  reporterHandle String?
  reason         String
  detail         String?
  channel        String?
  status         CaseStatus   @default(OPEN)
  priority       CasePriority @default(NORMAL)
  assigneeId     String?
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subject  User?      @relation("CaseSubject", fields: [subjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignee User?      @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  notes    CaseNote[]

  @@index([status, priority])
  @@index([createdAt])
  @@index([assigneeId])
  @@map("moderation_cases")
}

/// Internal case notes. Author handle is denormalised so the note survives deletion.

model CaseNote {
  id           String   @id @default(cuid())
  caseId       String
  authorId     String?
  authorHandle String
  body         String
  createdAt    DateTime @default(now())

  case   ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author User?          @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([caseId, createdAt])
  @@map("case_notes")
}

/// Append-only staff action log. Every privileged mutation writes one row.

model StaffAudit {
  id          String     @id @default(cuid())
  actorId     String?
  actorHandle String
  actorRole   StaffRole?
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  summary     String
  metadata    Json?
  ip          String?
  createdAt   DateTime   @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("staff_audit")
}

/// Where a member plays, captured at sign-up.
enum PlayPlatform {
  PC
  CONSOLE
  BOTH
}

/// Join region, used for shard routing and the region badge on a profile.
enum Region {
  NORTH_AMERICA
  EUROPE
  LATIN_AMERICA
  MIDDLE_EAST_AFRICA
  ASIA_PACIFIC
  OCEANIA
}

/// Third-party identities that can open an ASTRO session without a password.
enum SignInProvider {
  STEAM
  XBOX
}

/// Sign-up facts that belong to Bleek rather than the shared account layer.
/// Absent for accounts created through Steam or Xbox, which never supply an email.
model AccountProfile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  /// Lowercased at write time, so one address maps to exactly one account.
  email               String       @unique
  region              Region
  platform            PlayPlatform
  /// Null until the member opens the verification link sent to this address.
  emailVerifiedAt     DateTime?
  /// SHA-256 of the live verification token. The token itself is never stored.
  emailTokenHash      String?
  emailTokenExpiresAt DateTime?
  /// Issue time of the live token, used to throttle resends.
  emailTokenSentAt    DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user User @relation("AccountProfile", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([region])
  @@index([platform])
  @@index([emailVerifiedAt])
  @@map("account_profiles")
}

/// A Steam or Xbox identity bound to an ASTRO account.
model LinkedSignIn {
  id                String         @id @default(cuid())
  userId            String
  provider          SignInProvider
  /// Provider-stable identifier: a SteamID64, or the Microsoft account `sub`.
  providerAccountId String
  providerHandle    String?
  createdAt         DateTime       @default(now())
  lastUsedAt        DateTime?

  user User @relation("AccountSignIns", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("linked_sign_ins")
}

/// A chat identity, one per ASTRO account. Coins mirror the shared wallet at
/// first use and are debited here as cosmetics are bought.
model ChatMember {
  id           String   @id
  handle       String   @unique
  name         String
  verified     Boolean  @default(false)
  region       String?
  playPlatform String?
  status       String   @default("online")
  avatarFrom   String   @default("#4f46e5")
  avatarTo     String   @default("#06b6d4")
  banner       String[]
  bio          String   @default("")
  pronouns     String   @default("")
  customStatus String?
  character    String   @default("comet")
  cosmetics    Json
  coins        Int      @default(0)
  owned        String[] @default([])
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  servers   ChatServer[]  @relation("ServerOwner")
  messages  ChatMessage[]
  giftsSent ChatGift[]    @relation("GiftsSent")
  giftsGot  ChatGift[]    @relation("GiftsReceived")

  @@index([joinedAt])
  @@map("chat_members")
}

/// A server owned by one member. Roles, guard rules and the storefront are
/// documents; channels, messages and payouts are rows so they can be queried.
model ChatServer {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  icon       String   @default("")
  color      String   @default("#4f46e5")
  position   Int      @default(0)
  roles      Json
  guard      Json
  flagged    Json     @default("[]")
  storefront Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    ChatMember    @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  channels ChatChannel[]

  @@index([ownerId, position])
  @@map("chat_servers")
}

model ChatChannel {
  id       String  @id @default(cuid())
  serverId String
  name     String
  type     String
  topic    String?
  layout   String?
  doc      String?
  position Int     @default(0)

  server   ChatServer    @relation(fields: [serverId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages ChatMessage[]

  @@unique([serverId, name])
  @@index([serverId, position])
  @@map("chat_channels")
}

model ChatMessage {
  id        String    @id @default(cuid())
  channelId String
  authorId  String
  content   String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  reactions Json      @default("[]")
  replyTo   String?
  pinned    Boolean   @default(false)

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author  ChatMember  @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([channelId, createdAt])
  @@index([authorId])
  @@map("chat_messages")
}

model ChatGift {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  itemId    String
  createdAt DateTime @default(now())

  from ChatMember @relation("GiftsSent", fields: [fromId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  to   ChatMember @relation("GiftsReceived", fields: [toId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([createdAt])
  @@map("chat_gifts")
}

/// A creator split, written when a storefront item sells.
model ChatPayout {
  id            String   @id @default(cuid())
  itemId        String
  serverId      String
  creatorId     String
  amount        Int
  creatorShare  Int
  platformShare Int
  createdAt     DateTime @default(now())

  @@index([serverId, createdAt])
  @@index([creatorId])
  @@map("chat_payouts")
}
