# ASTRO data layer. Prisma reads this before generating the client and running migrations.
# Point it at any PostgreSQL database; the schema lives in prisma/schema.prisma.
DATABASE_URL="postgresql://username:password@localhost:5432/astro?schema=public"

# Signs ASTRO session cookies. Use 32+ random characters, e.g. `openssl rand -base64 48`.
ASTRO_AUTH_SECRET="replace-me-with-32-or-more-random-characters"

# Signs ASTROids. Falls back to ASTRO_AUTH_SECRET when unset, but a dedicated
# secret keeps rotating the session key from invalidating every ASTROid.
ASTRO_ID_SECRET="replace-me-with-32-or-more-random-characters"

# Public origin providers call back to. Steam and Microsoft reject loopback
# callbacks, so set this to the deployed https origin before using them.
ASTRO_PUBLIC_ORIGIN="https://bleek.example.com"

# Optional: resolves a Steam persona name during sign-in. Without it the
# account is named from the SteamID64.
STEAM_API_KEY=""

# Xbox sign-in uses a Microsoft Entra app registration (consumers tenant).
# Leave both empty to keep the Xbox button disabled.
XBOX_CLIENT_ID=""
XBOX_CLIENT_SECRET=""
